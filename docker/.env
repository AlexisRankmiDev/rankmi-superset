# Allowing python to print() in docker
PYTHONUNBUFFERED=1

COMPOSE_PROJECT_NAME=superset
DEV_MODE=true

# Port configuration (override in .env-local for multiple instances)
# NGINX_PORT=80
# SUPERSET_PORT=8088
# Webpack dev server published on host (container internal port is always 9000).
# Use 9001 if something else uses 9000 on your machine (e.g. npm run dev-server).
NODE_PORT=9001
# WEBSOCKET_PORT=8080
# CYPRESS_PORT=8081
# DATABASE_PUBLISHED_PORT=5432
# REDIS_PORT=6379

# database configurations (do not modify)
DATABASE_DB=superset
DATABASE_HOST=db
# Make sure you set this to a unique secure random value on production
DATABASE_PASSWORD=superset
DATABASE_USER=superset

EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_USER=examples
# Make sure you set this to a unique secure random value on production
EXAMPLES_PASSWORD=examples
EXAMPLES_PORT=5432

# database engine specific environment variables
# change the below if you prefer another database engine
# DATABASE_PUBLISHED_PORT: published on host (see db service ports in docker-compose.yml).
# If you see "bind: address already in use" on 5432, set DATABASE_PUBLISHED_PORT=5433 (or any free port).
DATABASE_PUBLISHED_PORT=5433
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
POSTGRES_DB=superset
POSTGRES_USER=superset
# Make sure you set this to a unique secure random value on production
POSTGRES_PASSWORD=superset
#MYSQL_DATABASE=superset
#MYSQL_USER=superset
#MYSQL_PASSWORD=superset
#MYSQL_RANDOM_ROOT_PASSWORD=yes

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379

# Development and logging configuration
# FLASK_DEBUG: Enables Flask dev features (auto-reload, better error pages) - keep 'true' for development
FLASK_DEBUG=true
# SUPERSET_LOG_LEVEL: Controls Superset application logging verbosity (debug, info, warning, error, critical)
SUPERSET_LOG_LEVEL=info

SUPERSET_APP_ROOT="/"
SUPERSET_ENV=development
SUPERSET_LOAD_EXAMPLES=yes
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# Make sure you set this to a unique secure random value on production
SUPERSET_SECRET_KEY=TEST_NON_DEV_SECRET
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true

# MCP (AI clients: ChatGPT / Claude / Cursor). Exposes streamable-http at /mcp — no OpenAI key in Superset.
MCP_PORT=5008
# Optional: Superset username MCP tools run as when auth is disabled (local dev only).
# MCP_DEV_USERNAME=admin

# Redshift via Teleport on the host (127.0.0.1:port): docker/pythonpath_dev/superset_config.py
# rewrites loopback to host.docker.internal for redshift+ URIs. Set to false to disable.
# SUPERSET_DOCKER_REDSHIFT_LOOPBACK_REWRITE=false
# DOCKER_HOST_GATEWAY_HOST=host.docker.internal
